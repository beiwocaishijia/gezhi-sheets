{
    "name": "gezhi-sheets",
    "title": "格知 AI · Gezhi Sheets",
    "description": "让表格听懂你的话。支持五家模型的本地 AI 表格助手，提取、整理、计算，先预览再写入。",
    "repository": {
        "type": "git",
        "url": "https://github.com/beiwocaishijia/gezhi-sheets.git"
    },
    "author": {
        "name": "Contact <contact@jspreadsheet.com>"
    },
    "license": "MIT",
    "keywords": [
        "gezhi-sheets",
        "ai",
        "spreadsheet",
        "javascript",
        "jspreadsheet",
        "kimi",
        "glm",
        "doubao",
        "deepseek",
        "qwen",
        "xlsx",
        "csv"
    ],
    "dependencies": {
        "@jspreadsheet/formula": "^2.0.2",
        "decimal.js": "10.6.0",
        "exceljs": "4.4.0",
        "express": "5.3.0",
        "jsuites": "^5.12.0",
        "papaparse": "5.7.0",
        "webpack-dev-middleware": "5.3.4",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@babel/cli": "^7.7.4",
        "@babel/core": "^7.7.4",
        "@babel/preset-env": "^7.7.4",
        "@babel/register": "^7.7.4",
        "@eslint/js": "^9.34.0",
        "@playwright/test": "1.65.0",
        "c8": "^7.13.0",
        "chai": "^4.3.7",
        "copy-webpack-plugin": "^11.0.0",
        "cross-env": "^7.0.3",
        "css-loader": "^6.8.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.8.0",
        "globals": "^16.3.0",
        "html-replace-webpack-plugin": "^2.6.0",
        "html-webpack-plugin": "^5.5.0",
        "jsdoc": "^4.0.2",
        "jsdom": "^22.0.0",
        "jsdom-global": "^3.0.2",
        "mini-css-extract-plugin": "^2.7.6",
        "mocha": "^10.2.0",
        "mochawesome": "^7.1.3",
        "prettier": "2.8.8",
        "style-loader": "^3.3.1",
        "webpack": "^5.88.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.1"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "version": "5.0.4",
    "engines": {
        "node": ">=22.13.0"
    },
    "bugs": "https://github.com/beiwocaishijia/gezhi-sheets/issues",
    "homepage": "https://github.com/beiwocaishijia/gezhi-sheets#readme",
    "download": "https://github.com/beiwocaishijia/gezhi-sheets/archive/refs/heads/master.zip",
    "scripts": {
        "format": "npm run prettier:fix && npm run lint:fix",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write . --ignore-path .prettierignore",
        "start": "node server/index.cjs",
        "dev": "node server/index.cjs --dev",
        "start:component": "webpack serve --history-api-fallback",
        "build:app": "webpack --config webpack.app.config.cjs",
        "test:ai": "node --test test-ai/*.test.cjs",
        "test:browser": "playwright test --config playwright.config.cjs",
        "test:component": "cross-env NODE_ENV=production webpack --config webpack.config.js && mocha --recursive --require=mocha.config.js",
        "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
        "test": "npm run test:component && npm run test:ai"
    },
    "private": true
}
